# ============================================================
#  Environment variables for صندوق أكناف القربى
#  Copy this to .env.local for local dev,
#  or set these in Vercel → Settings → Environment Variables
# ============================================================

# Postgres database (use Vercel Postgres or any Postgres provider)
# Example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Cookie signing key (generate a random 32+ char string)
SESSION_SECRET=change-me-to-a-random-32-char-secret

# Moyasar payment gateway (optional)
# Leave PAYMENT_API_KEY empty to disable the gateway UI
PAYMENT_API_KEY=
PAYMENT_PUBLISHABLE_KEY=

# Vercel Blob storage (auto-set by Vercel when you add Blob)
# BLOB_READ_WRITE_TOKEN=

# Public site URL (used for callback URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
